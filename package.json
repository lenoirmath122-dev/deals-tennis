    "db:backfill-racquet-junior-size": "node --env-file=.env.local scripts/backfill-racquet-junior-size.ts",
    "db:backfill-r3-3": "node --env-file=.env.local scripts/backfill-r3-3.ts",
    "match:shadow": "node --env-file=.env.local scripts/matching/shadow-run.ts",
